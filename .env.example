# Copy this file to .env and fill in the values from your Supabase project.
# .env is git-ignored — never commit real keys.

# Supabase → Project Settings → Database → Connection pooling → Transaction mode.
# Use the pooler (port 6543), not the direct connection: serverless hosts open a
# connection per invocation and would exhaust Postgres otherwise.
# Replace [YOUR-PASSWORD] with the database password.
DATABASE_URL=postgresql://postgres.ppddhzqrgayiqhjnidve:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Supabase → Project Settings → API
SUPABASE_URL=https://ppddhzqrgayiqhjnidve.supabase.co

# The SECRET key (sb_secret_... / service_role), NOT the publishable one.
# Uploads and deletes bypass RLS and need the privileged key. Keep it server-side
# only — it must never appear in public/ or in any page the browser loads.
SUPABASE_SERVICE_KEY=

# Storage bucket for owner-uploaded photos (created automatically on first use).
SUPABASE_BUCKET=plantmood-uploads

# Admin password used only when the database has no admin password yet.
# Change it in Admin → Settings after the first login.
PLANTMOOD_ADMIN_PASSWORD=
