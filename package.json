{
  "name": "plantmood",
  "version": "1.0.0",
  "description": "Plantmood — Malaysian houseplant studio. Frontend + backend.",
  "private": true,
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "seed": "node --env-file-if-exists=.env server/seed.js",
    "import:sqlite": "node --env-file-if-exists=.env scripts/import-sqlite.js",
    "import:uploads": "node --env-file-if-exists=.env scripts/import-uploads.js",
    "backup": "node --env-file-if-exists=.env scripts/backup.js",
    "restore": "node --env-file-if-exists=.env scripts/restore.js",
    "tutorial:screenshots": "node scripts/capture-tutorial-screenshots.js",
    "tutorial:pdf": "node scripts/build-tutorial-pdf.js",
    "generate:tutorial": "npm run tutorial:screenshots && npm run tutorial:pdf"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "express": "^4.19.2",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "playwright": "^1.61.1"
  }
}
